# Cabeceras de Cloudflare Pages para aulix.alclick.dev (se copia a la raíz del build por angular.json).
# Sin 404.html, Pages ya sirve index.html en cualquier ruta de Angular: no hace falta _redirects.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.r2.cloudflarestorage.com; media-src 'self' blob: https:; frame-src 'self' https://*.r2.cloudflarestorage.com; connect-src 'self' https://api.alclick.dev https://*.r2.cloudflarestorage.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Los archivos con hash en el nombre no cambian nunca: el navegador los guarda un año
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# index.html siempre se revisa, para que una versión nueva llegue al instante
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
